{
  "name": "nocturne",
  "version": "1.0.0",
  "description": "NOCTURNE \u2014 Digital Atelier. Concept portfolio site.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "art:render": "node tools/artgen/render.mjs",
    "art:optimize": "node tools/optimize-images.mjs",
    "typecheck": "tsc --noEmit",
    "build:static": "tsc --noEmit && VITE_HASH_ROUTER=1 vite build --outDir dist-static"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.56.1",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "private": true,
  "type": "module"
}
